# =============================================================================
# AGENTIC RAG PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Purpose: Template for setting up your own .env file
# Instructions: Copy this file to .env and replace placeholder values with real ones
# =============================================================================

# =============================================================================
# 🔑 API KEYS (CRITICAL - Replace with your actual keys!)
# =============================================================================

# OpenAI API Key (PRIMARY LLM)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# =============================================================================
# 🔒 SECURITY SETTINGS
# =============================================================================

# IMPORTANT: Generate secure random keys for production!
# Generate JWT key: openssl rand -hex 32
# Generate encryption key: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-characters
ENCRYPTION_KEY=your-32-character-encryption-key

# =============================================================================
# 🚀 APPLICATION SETTINGS
# =============================================================================

ENVIRONMENT=development
DEBUG=true
APP_NAME=Macrocomm AI Assistant
APP_VERSION=2.0.0
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=*

# =============================================================================
# 🤖 LLM CONFIGURATION
# =============================================================================
# PRIORITY ORDER: OpenAI (Primary) → Ollama (Fallback)
# Performance: OpenAI ~2-3s | Ollama ~45s response time
# =============================================================================

# OpenAI Configuration (PRIMARY - ALWAYS TRY FIRST)
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7
OPENAI_TOP_P=0.9
OPENAI_TIMEOUT=30

# Ollama Configuration (FALLBACK - If OpenAI fails)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60
FALLBACK_MODEL=mistral:7b-instruct

# Embedding Models (for vector search)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=BAAI/bge-reranker-base

# =============================================================================
# 💾 VECTOR DATABASE (Qdrant)
# =============================================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_DISTANCE_METRIC=cosine
QDRANT_VECTOR_SIZE=384

# =============================================================================
# 🗄️ REDIS CACHE (Optional - Currently Disabled)
# =============================================================================

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# 📄 DOCUMENT PROCESSING
# =============================================================================

DOCUMENTS_PATH=./data/documents
UPLOAD_PATH=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv,xlsx

# Chunking Strategy (Optimized for RAG)
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
CHUNK_STRATEGY=recursive

# =============================================================================
# 🔍 RETRIEVAL SETTINGS (RAG Configuration)
# =============================================================================

RETRIEVAL_K=8
RERANK_TOP_K=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
SIMILARITY_THRESHOLD=0.65
CONFIDENCE_THRESHOLD=0.6

# Hybrid Search Settings
USE_HYBRID_SEARCH=true
USE_RERANKING=true
USE_MMR=false

# =============================================================================
# 🧠 COGNITIVE REASONING (Agentic Features)
# =============================================================================

REASONING_ENABLED=true
DEFAULT_REASONING_STRATEGY=analytical
MAX_REASONING_DEPTH=3
CONFIDENCE_SCORING=true

# Memory Systems
CONVERSATION_MEMORY_ENABLED=true
LEARNING_MEMORY_ENABLED=true
EPISODIC_MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=90

# =============================================================================
# ⚡ PERFORMANCE & RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# WebSocket Settings
WEBSOCKET_TIMEOUT=300
WEBSOCKET_HEARTBEAT_INTERVAL=30

# =============================================================================
# 📊 LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=INFO
LOG_PATH=./data/logs
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
ENABLE_TRACING=false

# =============================================================================
# 🏢 MULTI-TENANCY
# =============================================================================

DEFAULT_TENANT=macrocomm-internal
MAX_TENANTS=100
STORAGE_QUOTA_GB=10
TENANT_ISOLATION=true

# =============================================================================
# 🎨 MACROCOMM WIDGET CONFIGURATION
# =============================================================================

WIDGET_ENABLED=true
WIDGET_MAX_MESSAGE_LENGTH=4000
WIDGET_POSITION=bottom-right
WIDGET_ANIMATION=slide

# Macrocomm Brand Colors (Official)
WIDGET_THEME_PRIMARY=#FF6E00
WIDGET_THEME_SECONDARY=#FF923F
WIDGET_THEME_ACCENT=#FFB67F
WIDGET_THEME_BACKGROUND=#FFFFFF
WIDGET_THEME_TEXT=#333333

# Widget Features
WIDGET_SHOW_BRANDING=true
WIDGET_SHOW_TYPING_INDICATOR=true
WIDGET_SHOW_TIMESTAMP=true
WIDGET_ENABLE_FILE_UPLOAD=true
WIDGET_ENABLE_VOICE=false

# =============================================================================
# 🔐 ADMIN & API SETTINGS
# =============================================================================

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@macrocomm.co.za
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs
ENABLE_ADMIN_PANEL=true
ADMIN_PANEL_PATH=/admin

# =============================================================================
# 🌐 CORS & SECURITY
# =============================================================================

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Security Headers
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# =============================================================================
# 📧 NOTIFICATIONS (Optional - Future Use)
# =============================================================================

NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
NOTIFICATION_EMAIL=notifications@example.com

# =============================================================================
# 🚀 DEPLOYMENT SETTINGS
# =============================================================================

DEPLOYMENT_ENV=development
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
GRACEFUL_TIMEOUT=30

# =============================================================================
# 🐛 DEBUG & DEVELOPMENT
# =============================================================================

VERBOSE_LOGGING=false
PRINT_RETRIEVAL_RESULTS=false
PRINT_LLM_PROMPTS=false
SAVE_CHAT_LOGS=true
ENABLE_PROFILING=false

# =============================================================================
# 📝 SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Replace OPENAI_API_KEY with your actual OpenAI API key
# 3. Generate secure JWT_SECRET_KEY and ENCRYPTION_KEY for production
# 4. Adjust settings based on your deployment environment
# 5. Never commit .env file to Git (it's in .gitignore)
# 6. OpenAI is PRIMARY for best performance (2-3s response time)
# 7. Ollama is FALLBACK if OpenAI fails or is unavailable
# 8. Collection name MUST be "knowledge_base" to match code
# 9. For production: set ENVIRONMENT=production and DEBUG=false
