# Copy this exact content to your .env file

# REQUIRED SECURITY SETTINGS (Fixed values)
JWT_SECRET_KEY=agentic-rag-super-secret-jwt-key-for-development-change-in-production
ENCRYPTION_KEY=12345678901234567890123456789012

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=Agentic RAG Pipeline
APP_VERSION=1.0.0
API_HOST=localhost
API_PORT=8000

# Ollama Configuration (Working values from your test)
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=llama3.2:3b-instruct-q4_K_M
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=BAAI/bge-reranker-base
FALLBACK_MODEL=mistral:7b-instruct

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=documents

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Document Processing
DOCUMENTS_PATH=./data/documents
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval Settings
RETRIEVAL_K=8
RERANK_TOP_K=4
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
SIMILARITY_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_PATH=./data/logs

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Multi-tenancy
DEFAULT_TENANT=macrocomm-internal
MAX_TENANTS=100
STORAGE_QUOTA_GB=10

# Widget Configuration
WIDGET_ENABLED=true
WIDGET_MAX_MESSAGE_LENGTH=4000
WIDGET_THEME_PRIMARY=#007bff
WIDGET_THEME_ACCENT=#28a745
WIDGET_THEME_BACKGROUND=#ffffff