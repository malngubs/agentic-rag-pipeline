# ============================================================================
# 🔐 ENVIRONMENT VARIABLES - MACROCOMM BI PLATFORM
# ============================================================================
# 
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL (FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time streaming
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# OPTIONAL: PRODUCTION CONFIGURATION
# =============================================================================

# Uncomment these for production deployment
# NEXT_PUBLIC_API_URL=https://api.macrocomm.ai
# NEXT_PUBLIC_WS_URL=wss://api.macrocomm.ai

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# OPTIONAL: FEATURE FLAGS
# =============================================================================

# Enable/disable features
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_EXPORT=true
# NEXT_PUBLIC_ENABLE_DARK_MODE=true
