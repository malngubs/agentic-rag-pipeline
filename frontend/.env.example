# =============================================================================
# MACROCOMM BI PLATFORM - Environment Variables
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Update the values below if your backend runs on a different port/host
# 3. IMPORTANT: Restart the dev server after creating/modifying .env.local
#    (Next.js requires a full restart to load new environment variables)
#
# =============================================================================
 
# -----------------------------------------------------------------------------
# BACKEND CONNECTION (REQUIRED)
# -----------------------------------------------------------------------------
# These URLs must match where your backend server (uvicorn) is running.
# Default: Backend runs on localhost:8000
 
# REST API URL - Used for HTTP requests (upload, chat, analytics, etc.)
NEXT_PUBLIC_API_URL=http://localhost:8000
 
# WebSocket URL - Used for real-time streaming chat responses
# Must use ws:// (not http://) for WebSocket connections
NEXT_PUBLIC_WS_URL=ws://localhost:8000
 
# -----------------------------------------------------------------------------
# OPTIONAL SETTINGS
# -----------------------------------------------------------------------------
 
# Enable analytics tracking (Google Analytics, etc.)
# Leave empty to disable analytics
NEXT_PUBLIC_GA_ID=
 
# Enable debug mode for additional console logging
# Set to 'true' to enable verbose logging in browser console
NEXT_PUBLIC_DEBUG=false
 
# Enable analytics feature (frontend analytics dashboard)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
 
# -----------------------------------------------------------------------------
# PRODUCTION SETTINGS (update these for deployment)
# -----------------------------------------------------------------------------
# When deploying to production, update these to your actual server URLs:
#
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
#
# Note: Use wss:// (WebSocket Secure) for production HTTPS deployments
# -----------------------------------------------------------------------------
